SYSTEM_NAME=components
COMPONENT_ID=security_monitor
BROKER_USER=security_monitor
BROKER_PASSWORD=security_monitor_secret
POLICY_ADMIN_SENDER=security_monitor_admin
# SECURITY_POLICIES задаётся вручную. Скопируйте строку ниже в .env или в переменные окружения.
# ОрВД: mission_handler (register_drone, register_mission), autopilot (request_takeoff), telemetry (send_telemetry, cmd для EMERGENCY_STOP)
SECURITY_POLICIES=[{"sender":"limiter","topic":"${SYSTEM_NAME}.navigation","action":"get_state"},{"sender":"limiter","topic":"${SYSTEM_NAME}.telemetry","action":"get_state"},{"sender":"limiter","topic":"${SYSTEM_NAME}.emergensy","action":"limiter_event"},{"sender":"limiter","topic":"${SYSTEM_NAME}.journal","action":"log_event"},{"sender":"mission_handler","topic":"${SYSTEM_NAME}.autopilot","action":"mission_load"},{"sender":"mission_handler","topic":"${SYSTEM_NAME}.limiter","action":"mission_load"},{"sender":"mission_handler","topic":"${SYSTEM_NAME}.journal","action":"log_event"},{"sender":"mission_handler","topic":"v1.ORVD.ORVD001.main","action":"register_drone"},{"sender":"mission_handler","topic":"v1.ORVD.ORVD001.main","action":"register_mission"},{"sender":"autopilot","topic":"${SYSTEM_NAME}.navigation","action":"get_state"},{"sender":"autopilot","topic":"${SYSTEM_NAME}.motors","action":"set_target"},{"sender":"autopilot","topic":"${SYSTEM_NAME}.sprayer","action":"set_spray"},{"sender":"autopilot","topic":"${SYSTEM_NAME}.journal","action":"log_event"},{"sender":"autopilot","topic":"v1.ORVD.ORVD001.main","action":"request_takeoff"},{"sender":"navigation","topic":"${SYSTEM_NAME}.sitl_adapter","action":"get_state"},{"sender":"navigation","topic":"${SYSTEM_NAME}.journal","action":"log_event"},{"sender":"emergensy","topic":"${SYSTEM_NAME}.motors","action":"land"},{"sender":"emergensy","topic":"${SYSTEM_NAME}.sprayer","action":"set_spray"},{"sender":"emergensy","topic":"${SYSTEM_NAME}.journal","action":"log_event"},{"sender":"emergensy","topic":"${SYSTEM_NAME}.security_monitor","action":"isolation_status"},{"sender":"telemetry","topic":"${SYSTEM_NAME}.motors","action":"get_state"},{"sender":"telemetry","topic":"${SYSTEM_NAME}.sprayer","action":"get_state"},{"sender":"telemetry","topic":"${SYSTEM_NAME}.navigation","action":"get_state"},{"sender":"telemetry","topic":"${SYSTEM_NAME}.autopilot","action":"cmd"},{"sender":"telemetry","topic":"v1.ORVD.ORVD001.main","action":"send_telemetry"},{"sender":"sprayer","topic":"${SYSTEM_NAME}.journal","action":"log_event"},{"sender":"motors","topic":"${SYSTEM_NAME}.sitl.commands","action":"command"},{"sender":"nsu","topic":"${SYSTEM_NAME}.mission_handler","action":"load_mission"},{"sender":"nsu","topic":"${SYSTEM_NAME}.mission_handler","action":"validate_only"},{"sender":"orvd","topic":"${SYSTEM_NAME}.mission_handler","action":"load_mission"},{"sender":"orvd","topic":"${SYSTEM_NAME}.mission_handler","action":"validate_only"}]

# Таймаут реального request к целевому компоненту внутри МБ
SECURITY_MONITOR_PROXY_REQUEST_TIMEOUT_S=10.0
